    - id: 4
      questType: 1
      nodeConfigs:
      - nodeId: 1
        name: "\u542C\u7434"
        questTip: "\u8425\u5730\u91CC\u6709\u4EBA\u5728\u5F39\u4E00\u628A\u7F3A\u4E86\u5F26\u7684\u7434\uFF0C\u53BB\u542C\u542C\u3002"
        description: "\u4F60\u8DEF\u8FC7\u8425\u5730\u89D2\u843D\uFF0C\u542C\u89C1\u65AD\u65AD\u7EED\u7EED\u7684\u7434\u58F0\u3002\u4E00\u4E2A\u7537\u4EBA\u5750\u5728\u5730\u4E0A\uFF0C\u62B1\u7740\u4E00\u628A\u65E7\u7434\uFF0C\u7434\u4E0A\u53EA\u5269\u4E09\u6839\u5F26\u3002\u4ED6\u5F39\u5F97\u5F88\u6162\uFF0C\u6BCF\u5F39\u51E0\u4E0B\u5C31\u505C\u4E00\u505C\uFF0C\u50CF\u5728\u7B49\u4EC0\u4E48\u58F0\u97F3\u63A5\u4E0A\u6765\u3002\r\n\r\n\u4F60\u7AD9\u4F4F\u542C\u4E86\u4E00\u4F1A\u513F\u3002\u4ED6\u62AC\u5934\u770B\u4F60\u3002\r\n\r\n\u201C\u5C11\u4E86\u4E24\u6839\u3002\u201D\u4ED6\u8BF4\uFF0C\u6307\u4E86\u6307\u7434\uFF0C\u201C\u5F39\u4E0D\u5168\u4E86\u3002\u201D\r\n\r\n\u201C\u4E3A\u4EC0\u4E48\u4E0D\u6362\u65B0\u7684\uFF1F\u201D\r\n\r\n\u201C\u6362\u4E86\u5C31\u4E0D\u662F\u8FD9\u628A\u4E86\u3002\u201D\r\n\r\n\u4ED6\u53C8\u62E8\u4E86\u4E00\u4E0B\u5F26\uFF0C\u58F0\u97F3\u53D1\u95F7\u3002\r\n\r\n\u201C\u4F60\u542C\u8FC7\u8FD9\u9996\u66F2\u5B50\u5417\uFF1F\u201D\u4ED6\u95EE\u3002\r\n\r\n\u201C\u6CA1\u6709\u3002\u201D\r\n\r\n\u201C\u5BF9\u3002\u6CA1\u4EBA\u542C\u8FC7\u3002\u201D\u4ED6\u4F4E\u4E0B\u5934\uFF0C\u201C\u56E0\u4E3A\u7F3A\u7684\u90A3\u4E24\u6839\u5F26\uFF0C\u624D\u662F\u4E3B\u8C03\u3002\u5269\u4E0B\u7684\uFF0C\u53EA\u662F\u4F34\u594F\u3002\u201D\r\n\r\n\u4ED6\u4E0D\u518D\u8BF4\u8BDD\uFF0C\u7EE7\u7EED\u5F39\u4ED6\u7684\u4E09\u6839\u5F26\u3002\u4F60\u8F6C\u8EAB\u8981\u8D70\u7684\u65F6\u5019\uFF0C\u4ED6\u7A81\u7136\u53C8\u5F00\u53E3\u3002\r\n\r\n\u201C\u5E2E\u4E2A\u5FD9\u3002\u201D\u4ED6\u8BF4\uFF0C\u201C\u5317\u8FB9\u6709\u4E2A\u8001\u5934\uFF0C\u4EE5\u524D\u4FEE\u7434\u7684\u3002\u4F60\u544A\u8BC9\u4ED6\uFF0C\u6211\u8FD9\u628A\u7434\u60F3\u4FEE\u4E86\u3002\u201D"
        maxProgress: 1
        conditionType: 0
        rewardItemIds: 10006,1;10004,100
