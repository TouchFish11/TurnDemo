      - nodeId: 2
        name: "\u56DE\u8BDD"
        questTip: "\u53BB\u5317\u8FB9\u627E\u4FEE\u7434\u7684\u8001\u4EBA\uFF0C\u66FF\u5F39\u7434\u4EBA\u4F20\u8BDD\u3002"
        description: "\u4F60\u627E\u5230\u4FEE\u7434\u8001\u4EBA\u7684\u65F6\u5019\uFF0C\u4ED6\u6B63\u5728\u5288\u67F4\u3002\u542C\u5B8C\u4F60\u7684\u8BDD\uFF0C\u4ED6\u65A7\u5B50\u505C\u5728\u534A\u7A7A\uFF0C\u6CA1\u843D\u4E0B\u53BB\u3002\r\n\r\n\u201C\u4ED6\u8FD8\u5F39\u7434\uFF1F\u201D\u8001\u4EBA\u95EE\u3002\r\n\r\n\u201C\u5F39\u3002\u4E09\u6839\u5F26\u3002\u201D\r\n\r\n\u8001\u4EBA\u628A\u65A7\u5B50\u63D2\u8FDB\u6728\u58A9\u91CC\uFF0C\u62CD\u4E86\u62CD\u624B\u4E0A\u7684\u6728\u5C51\uFF0C\u6CA1\u8BF4\u8BDD\u3002\u8FC7\u4E86\u597D\u4E00\u4F1A\u513F\uFF0C\u4ED6\u8D70\u8FDB\u5C4B\u91CC\uFF0C\u51FA\u6765\u65F6\u624B\u91CC\u62FF\u7740\u4E24\u6839\u7434\u5F26\uFF0C\u7528\u5E03\u5305\u7740\u3002\r\n\r\n\u201C\u4F60\u5E26\u7ED9\u4ED6\u3002\u201D\u4ED6\u628A\u5E03\u5305\u9012\u7ED9\u4F60\uFF0C\u201C\u544A\u8BC9\u4ED6\uFF0C\u5F26\u6211\u4E00\u76F4\u7559\u7740\u3002\u201D\r\n\r\n\u201C\u60A8\u600E\u4E48\u77E5\u9053\u4ED6\u4F1A\u8981\uFF1F\u201D\r\n\r\n\u8001\u4EBA\u7B11\u4E86\u4E00\u4E0B\uFF0C\u5F88\u96BE\u770B\u3002\r\n\r\n\u201C\u90A3\u7434\u662F\u6211\u505A\u7684\u3002\u5F26\u662F\u6211\u4E0A\u7684\u3002\u4ED6\u6454\u7434\u90A3\u5929\uFF0C\u628A\u8FD9\u4E24\u6839\u62BD\u51FA\u6765\u6254\u7ED9\u6211\uFF0C\u8BF4\u518D\u4E5F\u4E0D\u5F39\u4E86\u3002\u201D\r\n\r\n\u201C\u4E3A\u4EC0\u4E48\u6454\uFF1F\u201D\r\n\r\n\u201C\u4ED6\u5AB3\u5987\u6CA1\u4E86\u3002\u90A3\u9996\u66F2\u5B50\u662F\u5979\u5199\u7684\uFF0C\u4E3B\u8C03\u5728\u5979\u90A3\u513F\u3002\u4ED6\u5F39\u4E0D\u4E86\u3002\u201D\r\n\r\n\u8001\u4EBA\u8F6C\u8EAB\u56DE\u53BB\u5288\u67F4\uFF0C\u80CC\u5BF9\u7740\u4F60\u3002\r\n\r\n\u201C\u544A\u8BC9\u4ED6\uFF0C\u4E3B\u8C03\u6211\u8BB0\u4E0B\u6765\u4E86\u3002\u201D\u65A7\u5B50\u843D\u4E0B\uFF0C\u201C\u80FD\u8865\u3002\u201D"
