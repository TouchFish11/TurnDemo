      - nodeId: 4
        name: "\u8A00\u8BED\u6C89\u843D\u4E4B\u5904"
        questTip: "\u548C\u6D41\u6D6A\u8005\u544A\u522B"
        description: "\u6D41\u6D6A\u8005\u7AD9\u5728\u8425\u5730\u95E8\u53E3\uFF0C\u80CC\u7740\u4E00\u4E2A\u65E7\u5305\u88B1\u3002\u5929\u8FD8\u6CA1\u4EAE\u3002\r\n\r\n\u4F60\u8D70\u8FC7\u53BB\u3002\u4ED6\u770B\u89C1\u4F60\uFF0C\u70B9\u4E86\u70B9\u5934\u3002\r\n\r\n\u201C\u8D70\u4E86\uFF1F\u201D\r\n\r\n\u201C\u8D70\u4E86\u3002\u201D\r\n\r\n\u201C\u53BB\u54EA\uFF1F\u201D\r\n\r\n\u201C\u56DE\u6CB3\u8FB9\u3002\u201D\u4ED6\u8BF4\uFF0C\u201C\u6B20\u7684\u4E1C\u897F\uFF0C\u5F97\u81EA\u5DF1\u53BB\u8FD8\u3002\u201D\r\n\r\n\u4ED6\u4ECE\u6000\u91CC\u6478\u51FA\u4E00\u6837\u4E1C\u897F\u9012\u7ED9\u4F60\u3002\u662F\u4E00\u679A\u7EBD\u6263\uFF0C\u548C\u53F2\u8482\u592B\u624B\u91CC\u90A3\u679A\u4E00\u6A21\u4E00\u6837\u3002\r\n\r\n\u201C\u66FF\u6211\u8FD8\u7ED9\u4ED6\u3002\u201D\u4ED6\u8BF4\uFF0C\u201C\u8DDF\u4ED6\u8BF4\uFF0C\u4ED6\u7239\u5F53\u5E74\u628A\u6211\u4ECE\u6CB3\u91CC\u635E\u4E0A\u6765\u7684\u65F6\u5019\uFF0C\u6211\u8EAB\u4E0A\u5C31\u6389\u4E86\u8FD9\u679A\u6263\u5B50\u3002\u4ED6\u7239\u6361\u8D77\u6765\u585E\u56DE\u6211\u624B\u91CC\uFF0C\u8BF4\u2014\u2014\u2018\u6D3B\u7740\u5C31\u884C\u3002\u2019\u201D\r\n\r\n\u4ED6\u628A\u5305\u88B1\u5F80\u80A9\u4E0A\u63D0\u4E86\u63D0\u3002\r\n\r\n\u201C\u6211\u6D3B\u4E86\u4E94\u5341\u5E74\uFF0C\u591F\u4E86\u3002\u73B0\u5728\u8BE5\u56DE\u53BB\u8DDF\u4ED6\u8BF4\u4E00\u58F0\u3002\u201D\r\n\r\n\u4ED6\u8F6C\u8EAB\u8D70\u8FDB\u6668\u96FE\u91CC\u3002\u8D70\u4E86\u51E0\u6B65\uFF0C\u53C8\u505C\u4E0B\uFF0C\u6CA1\u56DE\u5934\u3002\r\n\r\n\u201C\u544A\u8BC9\u4ED6\uFF0C\u522B\u8DDF\u6765\u3002\u201D\r\n\r\n\u7136\u540E\u4ED6\u7EE7\u7EED\u8D70\uFF0C\u8EAB\u5F71\u4E00\u70B9\u70B9\u88AB\u96FE\u541E\u6CA1\u3002\u4F60\u624B\u91CC\u6525\u7740\u90A3\u679A\u7EBD\u6263\uFF0C\u8FD8\u5E26\u7740\u4ED6\u7684\u4F53\u6E29\u3002"
