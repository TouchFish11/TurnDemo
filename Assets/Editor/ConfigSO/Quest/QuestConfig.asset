      - nodeId: 2
        name: "\u95EE\u8BDD"
        questTip: "\u966A\u53F2\u8482\u592B\u53BB\u627E\u6D41\u6D6A\u8005\uFF0C\u95EE\u6E05\u695A\u7EBD\u6263\u7684\u4E8B\u3002"
        description: "\u6D41\u6D6A\u8005\u5750\u5728\u8425\u5730\u5916\u7684\u77F3\u5934\u4E0A\uFF0C\u80CC\u5BF9\u7740\u4F60\u4EEC\u3002\u542C\u89C1\u811A\u6B65\u58F0\uFF0C\u4ED6\u6CA1\u56DE\u5934\u3002\r\n\r\n\u201C\u6765\u4E86\u3002\u201D\u4ED6\u8BF4\uFF0C\u50CF\u65E9\u77E5\u9053\u3002\r\n\r\n\u53F2\u8482\u592B\u7AD9\u5728\u4ED6\u8EAB\u540E\uFF0C\u6525\u7740\u7EBD\u6263\uFF0C\u624B\u6709\u70B9\u6296\u3002\r\n\r\n\u201C\u4F60\u600E\u4E48\u77E5\u9053\u6211\u7684\u540D\u5B57\uFF1F\u201D\u53F2\u8482\u592B\u95EE\u3002\r\n\r\n\u201C\u4F60\u5C0F\u65F6\u5019\u4F4F\u5317\u8FB9\u90A3\u4E2A\u6751\u5B50\u3002\u201D\u6D41\u6D6A\u8005\u8BF4\uFF0C\u201C\u7B2C\u4E09\u6237\uFF0C\u95E8\u53E3\u6709\u68F5\u6B6A\u8116\u5B50\u6811\u3002\u4F60\u516D\u5C81\u90A3\u5E74\u6389\u8FDB\u6CB3\u91CC\uFF0C\u6709\u4EBA\u628A\u4F60\u635E\u4E0A\u6765\u7684\u3002\u201D\r\n\r\n\u201C\u8C01\uFF1F\u201D\r\n\r\n\u6D41\u6D6A\u8005\u6CA1\u56DE\u7B54\uFF0C\u8F6C\u8FC7\u5934\u6765\u3002\u8138\u4E0A\u6709\u9053\u65E7\u75A4\uFF0C\u4ECE\u7709\u9AA8\u62C9\u5230\u5634\u89D2\u3002\r\n\r\n\u201C\u4F60\u7239\u3002\u201D\u4ED6\u8BF4\uFF0C\u201C\u635E\u5B8C\u4F60\uFF0C\u4ED6\u6CA1\u4E0A\u6765\u3002\u201D\r\n\r\n\u53F2\u8482\u592B\u50F5\u5728\u90A3\u513F\u3002\u624B\u91CC\u7684\u7EBD\u6263\u6389\u5728\u5730\u4E0A\uFF0C\u6EDA\u4E86\u4E24\u5708\u3002\r\n\r\n\u6D41\u6D6A\u8005\u5F2F\u8170\u6361\u8D77\u6765\uFF0C\u653E\u56DE\u4ED6\u638C\u5FC3\u3002\r\n\r\n\u201C\u6211\u8DEF\u8FC7\u3002\u4ED6\u628A\u4F60\u9012\u7ED9\u6211\u7684\u3002\u201D\u6D41\u6D6A\u8005\u8BF4\uFF0C\u201C\u6211\u517B\u4E86\u4F60\u4E24\u5E74\uFF0C\u540E\u6765\u517B\u4E0D\u8D77\uFF0C\u9001\u4EBA\u4E86\u3002\u201D\r\n\r\n\u4ED6\u7AD9\u8D77\u6765\uFF0C\u62CD\u4E86\u62CD\u8EAB\u4E0A\u7684\u571F\u3002\r\n\r\n\u201C\u4E0D\u7528\u53EB\u6211\u4EC0\u4E48\u3002\u6211\u5C31\u662F\u6765\u770B\u770B\u4F60\u6D3B\u7740\u3002\u201D\r\n\r\n\u4ED6\u5F80\u8425\u5730\u5916\u8D70\u3002\u53F2\u8482\u592B\u7AD9\u5728\u539F\u5730\u770B\u7740\u4ED6\uFF0C\u4E00\u53E5\u8BDD\u4E5F\u6CA1\u8BF4\u51FA\u6765\u3002"
