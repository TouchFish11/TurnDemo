      - nodeId: 3
        name: "\u5728\u5BC2\u9759\u4E2D\u8046\u542C\u56DE\u58F0"
        questTip: "\u518D\u6B21\u548C\u53F2\u8482\u592B\u8C08\u8BDD"
        description: "\u53F2\u8482\u592B\u4E0D\u5728\u8425\u5730\u3002\u4F60\u5728\u6CB3\u8FB9\u627E\u5230\u4ED6\uFF0C\u7AD9\u5728\u6C34\u8FB9\uFF0C\u978B\u6E7F\u4E86\u4E00\u534A\u3002\r\n\r\n\u201C\u4ED6\u8BF4\u6DF1\u6E0A\u53EB\u7684\u662F\u4ED6\u3002\u201D\u4F60\u5F00\u53E3\u3002\r\n\r\n\u201C\u6211\u77E5\u9053\u3002\u201D\r\n\r\n\u201C\u4F60\u4FE1\u5417\uFF1F\u201D\r\n\r\n\u53F2\u8482\u592B\u6CA1\u9A6C\u4E0A\u56DE\u7B54\u3002\u6C34\u58F0\u5F88\u8F7B\uFF0C\u50CF\u6709\u4EBA\u5728\u8FDC\u5904\u8BF4\u8BDD\uFF0C\u53C8\u542C\u4E0D\u6E05\u3002\r\n\r\n\u201C\u6211\u516D\u5C81\u6389\u8FDB\u8FD9\u6761\u6CB3\u3002\u201D\u4ED6\u7EC8\u4E8E\u8BF4\uFF0C\u201C\u4ED6\u628A\u6211\u9012\u7ED9\u6211\u517B\u7236\u7684\u65F6\u5019\uFF0C\u6211\u770B\u4E86\u4ED6\u4E00\u773C\u3002\u6211\u8BB0\u5F97\u90A3\u5F20\u8138\u3002\u201D\r\n\r\n\u201C\u90A3\u4F60\u4E3A\u4EC0\u4E48\u88C5\u4F5C\u4E0D\u8BB0\u5F97\uFF1F\u201D\r\n\r\n\u201C\u56E0\u4E3A\u4ED6\u4E0D\u5E0C\u671B\u6211\u8BB0\u5F97\u3002\u201D\u53F2\u8482\u592B\u8F6C\u8FC7\u5934\uFF0C\u201C\u4ED6\u517B\u4E86\u6211\u4E24\u5E74\uFF0C\u7136\u540E\u628A\u6211\u9001\u8D70\u3002\u4E0D\u662F\u517B\u4E0D\u8D77\u3002\u662F\u4ED6\u6015\u3002\u6015\u6211\u8DDF\u7740\u4ED6\uFF0C\u65E9\u665A\u4E5F\u4F1A\u88AB\u90A3\u6761\u6CB3\u8981\u56DE\u53BB\u3002\u201D\r\n\r\n\u4ED6\u5F2F\u8170\u4ECE\u6C34\u91CC\u6361\u8D77\u4E00\u5757\u77F3\u5934\uFF0C\u6525\u5728\u624B\u91CC\u3002\r\n\r\n\u201C\u4ED6\u56DE\u5934\u4E86\u3002\u4E3A\u4E86\u6211\u3002\u201D\u53F2\u8482\u592B\u8BF4\uFF0C\u201C\u6240\u4EE5\u73B0\u5728\uFF0C\u8BE5\u6211\u4E86\u3002\u201D"
