      nodeConfigs:
      - nodeId: 1
        name: "\u642D\u8BDD"
        questTip: "\u53BB\u548C\u53F2\u8482\u592B\u804A\u804A\uFF0C\u4ED6\u597D\u50CF\u6709\u8BDD\u8981\u8BF4\u3002"
        description: "\u53F2\u8482\u592B\u7AD9\u5728\u8425\u5730\u8FB9\u4E0A\uFF0C\u624B\u91CC\u6525\u7740\u4EC0\u4E48\u4E1C\u897F\uFF0C\u773C\u775B\u5374\u4E00\u76F4\u5F80\u8425\u5730\u5916\u90A3\u6761\u8DEF\u4E0A\u779F\u3002\r\n\r\n\u4F60\u8D70\u8FC7\u53BB\u3002\r\n\r\n\u201C\u4F60\u8BA4\u8BC6\u90A3\u4E2A\u6D41\u6D6A\u8005\u5417\uFF1F\u201D\u4ED6\u5F00\u53E3\u5C31\u95EE\uFF0C\u6CA1\u7B49\u4F60\u56DE\u7B54\u3002\r\n\r\n\u201C\u54EA\u4E2A\u6D41\u6D6A\u8005\uFF1F\u201D\r\n\r\n\u201C\u5929\u5929\u5728\u8425\u5730\u5916\u9762\u8F6C\u7684\u90A3\u4E2A\u3002\u4E0D\u8FDB\u6765\uFF0C\u4E5F\u4E0D\u8D70\u8FDC\u3002\u201D\r\n\r\n\u201C\u4E0D\u719F\u3002\u201D\r\n\r\n\u201C\u6211\u4E5F\u4E0D\u719F\u3002\u201D\u53F2\u8482\u592B\u8BF4\uFF0C\u201C\u4F46\u4ED6\u6628\u5929\u53EB\u4E86\u6211\u7684\u540D\u5B57\u3002\u201D\r\n\r\n\u4ED6\u644A\u5F00\u624B\uFF0C\u638C\u5FC3\u91CC\u662F\u4E00\u679A\u65E7\u7EBD\u6263\u3002\r\n\r\n\u201C\u8FD9\u662F\u4ED6\u7ED9\u6211\u7684\u3002\u8BF4\u662F\u6211\u5C0F\u65F6\u5019\u8863\u670D\u4E0A\u6389\u7684\u3002\u6211\u4E0D\u8BB0\u5F97\u4E86\u3002\u53EF\u4ED6\u8BB0\u5F97\u3002\u201D\r\n\r\n\u4ED6\u6525\u56DE\u7EBD\u6263\uFF0C\u770B\u7740\u4F60\u3002\r\n\r\n\u201C\u6211\u60F3\u53BB\u627E\u4ED6\u95EE\u6E05\u695A\u3002\u4F60\u966A\u6211\u53BB\u3002\u201D"
