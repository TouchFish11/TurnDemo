      - nodeId: 2
        name: "\u6F6E\u6C50\u4E0E\u6697\u5F71\u7684\u5BF9\u8C08"
        questTip: "\u548C\u6D41\u6D6A\u8005\u8BE6\u8C08"
        description: "\u6D41\u6D6A\u8005\u8FD8\u5728\u8425\u5730\u5916\u90A3\u5757\u77F3\u5934\u4E0A\uFF0C\u50CF\u4ECE\u6CA1\u79BB\u5F00\u8FC7\u3002\u6F6E\u58F0\u4ECE\u8FDC\u5904\u4F20\u6765\uFF0C\u4E00\u9635\u4E00\u9635\u3002\r\n\r\n\u4F60\u5728\u4ED6\u65C1\u8FB9\u7AD9\u5B9A\u3002\u4ED6\u6CA1\u770B\u4F60\u3002\r\n\r\n\u201C\u53F2\u8482\u592B\u8DDF\u4F60\u8BF4\u4E86\u3002\u201D\u4ED6\u8BF4\uFF0C\u4E0D\u662F\u95EE\u53E5\u3002\r\n\r\n\u201C\u8BF4\u4E86\u3002\u201D\r\n\r\n\u201C\u4ED6\u89C9\u5F97\u6DF1\u6E0A\u5728\u53EB\u4ED6\u3002\u201D\r\n\r\n\u201C\u4F60\u89C9\u5F97\u5462\uFF1F\u201D\r\n\r\n\u6D41\u6D6A\u8005\u6C89\u9ED8\u4E86\u4E00\u9635\u3002\u6F6E\u58F0\u6DA8\u4E0A\u6765\uFF0C\u53C8\u9000\u4E0B\u53BB\u3002\r\n\r\n\u201C\u6DF1\u6E0A\u53EB\u7684\u4E0D\u662F\u4ED6\u3002\u201D\u4ED6\u8BF4\uFF0C\u201C\u662F\u6211\u3002\u201D\r\n\r\n\u4ED6\u8F6C\u8FC7\u5934\uFF0C\u8138\u4E0A\u7684\u65E7\u75A4\u5728\u6708\u5149\u4E0B\u50CF\u4E00\u6761\u5E72\u6DB8\u7684\u6CB3\u3002\r\n\r\n\u201C\u4E94\u5341\u5E74\u524D\uFF0C\u6211\u628A\u4ED6\u4ECE\u6CB3\u91CC\u635E\u51FA\u6765\u3002\u4ED6\u7239\u6C89\u4E0B\u53BB\u4E86\u3002\u6211\u6CA1\u635E\u3002\u201D\u4ED6\u8BF4\uFF0C\u201C\u6211\u4EE5\u4E3A\u8FD9\u4E8B\u8FC7\u53BB\u4E86\u3002\u4F46\u6DF1\u6E0A\u8BB0\u7740\u3002\u201D\r\n\r\n\u201C\u6240\u4EE5\u5B83\u6765\u627E\u4F60\u3002\u201D\r\n\r\n\u201C\u4E0D\u3002\u201D\u6D41\u6D6A\u8005\u7AD9\u8D77\u6765\uFF0C\u9762\u5411\u9ED1\u6697\uFF0C\u201C\u5B83\u4E00\u76F4\u5728\u3002\u53EA\u662F\u6628\u5929\uFF0C\u6211\u7B2C\u4E00\u6B21\u56DE\u4E86\u5934\u3002\u201D"
